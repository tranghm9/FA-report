# Sao chép file này thành ".env" rồi điền. KHÔNG commit file .env.
# Địa chỉ "Ứng dụng web" của Google Apps Script (xem README.md)
DATA_URL=
# Khóa bí mật bạn tự đặt (trùng với APP_KEY trong Apps Script)
DATA_KEY=
# Để trống hoặc "fixture" = dùng dữ liệu mẫu; "live" = đọc Google Sheet thật
DATA_MODE=fixture
